depends: [
  "ocaml" {>= "4.08.0"}
  "ocamlfind" {build}
  "conf-python-3" {build}
  "conf-c++" {build}
]
conflicts: ["ocaml-option-bytecode-only"]
build: [
  ["python3" "scripts/mk_make.py" "--ml"]
  [make "-C" "build" "-j" jobs]
]
install: [
  ["sh" "-c" "ocamlfind install z3 build/api/ml/* -dll build/libz3.*"]
  ["cp" "build/z3" "%{bin}%/z3"]
]
patches: [
  "gccstd-2a.patch"
    {os-family = "opensuse" | os-family = "suse" |
     os-distribution = "ubuntu" & os-version <= "20.04"}
]
